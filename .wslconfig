[wsl2]
# Use all 20 logical CPU cores
processors=20
# Disable WSLg (no Linux GUI apps used); stops msrdc.exe and its tray icon
guiApplications=false

[experimental]
# Gradually reclaim unused Linux memory back to Windows when idle
autoMemoryReclaim=gradual
# Use sparse virtual disk for faster operations and less host disk usage
sparseVhd=true
