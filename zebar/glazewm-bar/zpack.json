{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "glazewm-bar",
  "version": "1.0.0",
  "description": "Ritvik's glazewm bar. Source: dotwin zebar/glazewm-bar (see README.md).",
  "tags": [
    "topbar"
  ],
  "previewImages": [],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "index.html",
        "assets/*.js",
        "assets/*.css",
        "assets/*.woff2"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "bluetooth\\.ps1 (status|toggle)$"
          },
          {
            "program": "rundll32",
            "argsRegex": "^user32\\.dll,LockWorkStation$"
          },
          {
            "program": "shutdown",
            "argsRegex": "^(/l|/r /t 0|/s /t 0)$"
          },
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -NonInteractive -Command Add-Type -AssemblyName System\\.Windows\\.Forms; \\[System\\.Windows\\.Forms\\.Application\\]::SetSuspendState\\('Suspend', \\$false, \\$false\\) \\| Out-Null$"
          },
          {
            "program": "powershell",
            "argsRegex": "state\\.ps1 (get|set [A-Za-z0-9+/=]+)$"
          },
          {
            "program": "powershell",
            "argsRegex": "appicon\\.ps1 \\d+ [\\w.-]+$"
          },
          {
            "program": "powershell",
            "argsRegex": "endtask\\.ps1 \\d+$"
          },
          {
            "program": "powershell",
            "argsRegex": "windowvisible\\.ps1 \\d+$"
          },
          {
            "program": "powershell",
            "argsRegex": "audiodevice\\.ps1 set \\{[0-9.]+\\}\\.\\{[0-9a-fA-F-]+\\}$"
          },
          {
            "program": "explorer",
            "argsRegex": "^(ms-settings:[a-z-]*|ms-availablenetworks:|ms-actioncenter:(controlcenter/&showFooter=true)?|shell:AppsFolder\\\\NVIDIACorp\\.NVIDIAControlPanel_56jybvy8sckqj!NVIDIACorp\\.NVIDIAControlPanel)$"
          },
          {
            "program": "taskmgr",
            "argsRegex": "^$"
          },
          {
            "program": "C:\\Program Files\\NVIDIA Corporation\\NVIDIA App\\CEF\\NVIDIA App.exe",
            "argsRegex": "^$"
          },
          {
            "program": "nvidia-smi",
            "argsRegex": "^--query-gpu=temperature\\.gpu --format=csv,noheader,nounits$"
          },
          {
            "program": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "argsRegex": "^C:\\\\Users\\\\Ritvik\\\\Documents\\\\AutoHotkey\\\\taskbar\\.ahk (get|toggle|focus \\d+)$"
          },
          {
            "program": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "argsRegex": "^C:\\\\Users\\\\Ritvik\\\\Documents\\\\AutoHotkey\\\\brightness\\.ahk (get|up|down)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "34px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
