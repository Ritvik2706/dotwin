{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "glazewm-bar",
  "version": "1.0.0",
  "description": "Ritvik's glazewm bar (zebar-glazewm repo).",
  "tags": [
    "topbar"
  ],
  "previewImages": [],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "index.html",
        "assets/*.js",
        "assets/*.css"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "bluetooth\\.ps1 (status|toggle)$"
          },
          {
            "program": "rundll32",
            "argsRegex": "^user32\\.dll,LockWorkStation$"
          },
          {
            "program": "shutdown",
            "argsRegex": "^(/l|/r /t 0|/s /t 0)$"
          },
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -NonInteractive -Command Add-Type -AssemblyName System\\.Windows\\.Forms; \\[System\\.Windows\\.Forms\\.Application\\]::SetSuspendState\\('Suspend', \\$false, \\$false\\) \\| Out-Null$"
          },
          {
            "program": "powershell",
            "argsRegex": "state\\.ps1 (get|set [A-Za-z0-9+/=]+)$"
          },
          {
            "program": "powershell",
            "argsRegex": "appicon\\.ps1 [\\w .()+-]+$"
          },
          {
            "program": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "argsRegex": "^C:\\\\Users\\\\Ritvik\\\\Documents\\\\AutoHotkey\\\\taskbar\\.ahk (get|toggle)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "32px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
